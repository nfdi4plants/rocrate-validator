@prefix ro: <./> .
@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate/> .
@prefix isa-ro-crate: <https://github.com/crs4/rocrate-validator/profiles/isa-ro-crate/> .
@prefix arc-wr-workflow: <https://github.com/crs4/rocrate-validator/profiles/arc-wr-workflow/> .
@prefix workflow-ro-crate: <https://github.com/crs4/rocrate-validator/profiles/workflow-ro-crate/> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

arc-wr-workflow:MainWorkflowMustBeLabProtocol a sh:NodeShape ;
    sh:name "Main Workflow MUST be a LabProtocol" ;
    sh:description "The main workflow of the Workflow RO-Crate must be of type LabProtocol" ;
    sh:targetClass workflow-ro-crate:MainWorkflow ;
    sh:class bioschemas:LabProtocol ;
    sh:message "Main Workflow MUST be a LabProtocol" ;
    sh:severity sh:Violation ;
.

arc-wr-workflow:MainEntityMustBeARCWorkflow a sh:NodeShape ;
    sh:name "Main entity must be ARCWorkflow" ;
    sh:description "The main entity must be of type ARCWorkflow" ;
    sh:targetClass workflow-ro-crate:MainWorkflow ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalType ;
        sh:minCount 1 ;
        sh:hasValue "WorkflowProtocol" ;
        sh:description "Check if the main entity is specified as a workflow protocol through additionalType" ;
        sh:message "The main entity must have additionalType of `Workflow Protocol`" ;
        sh:severity sh:Violation ;
    ] ;
.