@prefix ro: <./> .
@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate/> .
@prefix isa-ro-crate: <https://github.com/crs4/rocrate-validator/profiles/isa-ro-crate/> .
@prefix arc-wr-workflow: <https://github.com/crs4/rocrate-validator/profiles/arc-wr-workflow/> .
@prefix workflow-ro-crate: <https://github.com/crs4/rocrate-validator/profiles/workflow-ro-crate/> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

arc-wr-workflow:RootDataEntityMustBeARCWorkflow a sh:NodeShape ;
    sh:name "Root Data Entity must be ARC Workflow" ;
    sh:description "The root data entity must follow the ARC workflow profile" ;
    sh:targetClass ro-crate:RootDataEntity ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalType ;
        sh:minCount 1 ;
        sh:hasValue "ARCWorkflow";
        sh:description "Check if the root data entity is specified as an ARC Workflow through additionalType" ;
        sh:message "The root data entity must have additionalType of `ARCWorkflow`" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:not [
            sh:hasValue ""
        ] ;
        sh:description "Check if the root data entity (ARC Workflow) has an identifier" ;
        sh:message "The root data entity must have a non-empty identifier" ;
        sh:severity sh:Violation ;
    ] ;
.